# Plantilla de datos para el despliegue público.
# Copiar a .env.prod (ese archivo NO se versiona) y completar los valores.
# Ver docs/despliegue.md §1 para saber de dónde sale cada uno.

# --- Servidor y dominio ---------------------------------------------------
DOMINIO=reservas.tudominio.edu
CORREO_TLS=admin@tudominio.edu
SERVIDOR_HOST=203.0.113.10
SERVIDOR_USUARIO=ubuntu
SERVIDOR_PUERTO_SSH=22
RUTA_LLAVE_SSH=C:\Users\tu-usuario\.ssh\id_ed25519

# --- Imagen de la API -----------------------------------------------------
IMAGEN_API=usuario/reservas-api:1.0.0

# --- Base de datos --------------------------------------------------------
BD_NOMBRE=ReservasEspaciosDb
MSSQL_PID=Express
MSSQL_SA_PASSWORD=cambia-esta-clave-Fuerte.2026!

# --- Seguridad de la API --------------------------------------------------
JWT_KEY=genera-32-caracteres-aleatorios-con-openssl-rand
JWT_ISSUER=https://reservas.tudominio.edu
JWT_AUDIENCE=reservas-espacios-spa
JWT_EXPIRA_MINUTOS=60

# --- Administrador inicial (idempotente al arrancar) ----------------------
SEED_ADMIN_EMAIL=admin@tudominio.edu
SEED_ADMIN_PASSWORD=cambia-esta-clave-Fuerte.2026!
SEED_ADMIN_NOMBRE=Administrador del Sistema

# --- Dominio de los correos institucionales -------------------------------
# Uno o varios dominios separados por comas; el prefijo @ es opcional.
DOMINIO_CORREO_INSTITUCIONAL=uninpahu.edu.co

# --- Entra ID (opcional; vacío = solo login local) ------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=

# --- Calendario, series y solicitudes -------------------------------------
TAMANO_MAXIMO_PDF_BYTES=5242880
MAX_SOLICITUDES_ACTIVAS=3
SEMANAS_MAXIMAS_POR_SERIE=20
ANTELACION_MINIMA_DIAS=3

# --- Servidor SMTP de notificaciones --------------------------------------
SMTP_HOST=smtp.tudominio.edu
SMTP_PUERTO=587
SMTP_USAR_SSL=false
SMTP_USUARIO=reservas@tudominio.edu
SMTP_CONTRASENA=cambia-esta-clave-smtp
SMTP_REMITENTE_CORREO=reservas@tudominio.edu
SMTP_REMITENTE_NOMBRE=Reservas de Espacios
SMTP_HABILITADO=true
SMTP_INTERVALO_SEGUNDOS=30

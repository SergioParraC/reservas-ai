{
	# Variante sin dominio ni TLS propio: Cloudflare termina TLS y reenvía HTTP a :80.
	# Uso: docker compose --env-file .env.prod -f docker-compose.prod.yml \
	#        -f docker-compose.tunnel.yml up -d
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
